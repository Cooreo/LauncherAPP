# Built application files
*.apk
*.aar
*.ap_
*.aab

# EXCEPT keep compiled release APKs in /releases
!/releases/
!/releases/**

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio / IntelliJ IDEA
*.iml
.idea/
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Keystore files
*.jks
*.keystore
# Keep deterministic project signing keystore so CI updates upgrade in-place without wiping data
!app/roomlauncher-debug.keystore

# OS files
.DS_Store
Thumbs.db
